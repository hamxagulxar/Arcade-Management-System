{
  "name": "arcade-management-system",
  "version": "1.0.0",
  "description": "Full-stack arcade management system: Express + SQL database + an in-memory data-structure engine (AVL tree, linked list, priority queue, stack).",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:reset": "node server/db/init.js --reset",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
